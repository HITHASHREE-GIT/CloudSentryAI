# ═══════════════════════════════════════════════
# CloudSentryAI — Git Ignore Rules
# ═══════════════════════════════════════════════

# ─── Python ───
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── Node / React ───
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.vite/
*.local

# ─── Environment / Secrets ───
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ─── Database ───
*.db
*.sqlite
*.sqlite3
*.db-journal

# ─── ML / Data ───
*.pkl
*.h5
*.joblib
*.onnx
!ml_workspace/models/.gitkeep
datasets/*.csv
!datasets/.gitkeep

# ─── Logs ───
*.log
logs/

# ─── IDE / Editor ───
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ───
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ─── OneDrive temp files ───
*.tmp
~$*
.desktop.ini

# ─── VS Code Extensions (personal tooling) ───
.synexus/
.github/